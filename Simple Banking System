import tkinter as tk
from tkinter import messagebox

class BankAccount:
    def __init__(self, account_number, name, balance=0):
        self.account_number = account_number
        self.name = name
        self.balance = balance

    def deposit(self, amount):
        self.balance += amount

    def withdraw(self, amount):
        if amount > self.balance:
            return False
        self.balance -= amount
        return True

    def get_balance(self):
        return self.balance

class BankApp:
    def __init__(self, root):
        self.root = root
        self.root.title("Simple Banking System")

        self.accounts = {}

        self.create_widgets()

    def create_widgets(self):
        tk.Label(self.root, text="Account Number").grid(row=0, column=0)
        tk.Label(self.root, text="Name").grid(row=1, column=0)
        tk.Label(self.root, text="Amount").grid(row=2, column=0)

        self.account_number_entry = tk.Entry(self.root)
        self.name_entry = tk.Entry(self.root)
        self.amount_entry = tk.Entry(self.root)

        self.account_number_entry.grid(row=0, column=1)
        self.name_entry.grid(row=1, column=1)
        self.amount_entry.grid(row=2, column=1)

        tk.Button(self.root, text="Create Account", command=self.create_account).grid(row=3, column=0)
        tk.Button(self.root, text="Deposit", command=self.deposit).grid(row=3, column=1)
        tk.Button(self.root, text="Withdraw", command=self.withdraw).grid(row=4, column=0)
        tk.Button(self.root, text="Check Balance", command=self.check_balance).grid(row=4, column=1)

    def create_account(self):
        account_number = self.account_number_entry.get()
        name = self.name_entry.get()
        if account_number in self.accounts:
            messagebox.showerror("Error", "Account already exists!")
        else:
            self.accounts[account_number] = BankAccount(account_number, name)
            messagebox.showinfo("Success", "Account created successfully!")

    def deposit(self):
        account_number = self.account_number_entry.get()
        amount = float(self.amount_entry.get())
        if account_number in self.accounts:
            self.accounts[account_number].deposit(amount)
            messagebox.showinfo("Success", "Amount deposited successfully!")
        else:
            messagebox.showerror("Error", "Account not found!")

    def withdraw(self):
        account_number = self.account_number_entry.get()
        amount = float(self.amount_entry.get())
        if account_number in self.accounts:
            if self.accounts[account_number].withdraw(amount):
                messagebox.showinfo("Success", "Amount withdrawn successfully!")
            else:
                messagebox.showerror("Error", "Insufficient balance!")
        else:
            messagebox.showerror("Error", "Account not found!")

    def check_balance(self):
        account_number = self.account_number_entry.get()
        if account_number in self.accounts:
            balance = self.accounts[account_number].get_balance()
            messagebox.showinfo("Balance", f"Account Balance: {balance}")
        else:
            messagebox.showerror("Error", "Account not found!")

if __name__ == "__main__":
    root = tk.Tk()
    app = BankApp(root)
    root.mainloop()
